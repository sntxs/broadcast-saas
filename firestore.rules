rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isClientOwner(clientId) {
      return isSignedIn() && request.auth.uid == clientId;
    }

    function ownsExistingDocument() {
      return isSignedIn() && resource.data.clientId == request.auth.uid;
    }

    function ownsIncomingDocument() {
      return isSignedIn() && request.resource.data.clientId == request.auth.uid;
    }

    match /clients/{clientId} {
      allow create: if isClientOwner(clientId);
      allow read, update, delete: if isClientOwner(clientId);
    }

    match /connections/{connectionId} {
      allow create: if ownsIncomingDocument();
      allow read, delete: if ownsExistingDocument();
      allow update: if ownsExistingDocument() && ownsIncomingDocument();
    }

    match /contacts/{contactId} {
      allow create: if ownsIncomingDocument();
      allow read, delete: if ownsExistingDocument();
      allow update: if ownsExistingDocument() && ownsIncomingDocument();
    }

    match /messages/{messageId} {
      allow create: if ownsIncomingDocument();
      allow read, delete: if ownsExistingDocument();
      allow update: if ownsExistingDocument() && ownsIncomingDocument();
    }
  }
}